# ==========================================
# PostgreSQL Data Warehouse Configuration
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zomato_dw
DB_USER=postgres
DB_PASSWORD=postgres

# ==========================================
# Application & Paths Configuration
# ==========================================
DATASET_PATH=./zomato_dataset
PROCESSED_DATA_DIR=./data/processed
ML_ARTIFACTS_DIR=./ml/artifacts
SQL_SCRIPTS_DIR=./sql

# ==========================================
# FastAPI Backend Configuration
# ==========================================
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ==========================================
# ML & Mining Hyperparameters
# ==========================================
KMEANS_N_CLUSTERS=4
KMEANS_RANDOM_STATE=42
CHURN_INACTIVITY_DAYS=180
FP_GROWTH_MIN_SUPPORT=0.01
FP_GROWTH_MIN_LIFT=1.1
